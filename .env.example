# Copier ce fichier en .env et remplir les valeurs

NODE_ENV=production
PORT=3000

# PostgreSQL — fourni automatiquement par Railway
DATABASE_URL=postgresql://user:password@host:5432/pulseboard

# Clé secrète pour les cookies JWT — générer une clé aléatoire longue
JWT_SECRET=change-this-to-a-long-random-secret-key

# Requis uniquement avec docker-compose.yml
POSTGRES_PASSWORD=change-this-to-a-strong-database-password

# URL publique utilisée dans les emails de vérification et de récupération
PUBLIC_APP_URL=https://votre-domaine.example

# Emails transactionnels (créer et vérifier un domaine chez Resend)
RESEND_API_KEY=
EMAIL_FROM=PulseBoard <compte@votre-domaine.example>

# Lien de paiement fourni par le compte marchand Wave Business
WAVE_PAYMENT_LINK=

# Activer seulement après avoir testé et validé le paiement
BILLING_ENFORCED=false

# Comptes autorisés à confirmer manuellement les paiements (séparés par des virgules)
PULSEBOARD_ADMIN_EMAILS=
